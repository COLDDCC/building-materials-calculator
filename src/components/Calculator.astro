---
import { unitLabel } from '../lib/units.js';
import { ICONS } from '../lib/icons.js';

const { config } = Astro.props;

// 构建期先算一遍默认值，SSR 出真实数字：无 JS 也可读，且不产生 CLS
const defaults = {};
for (const i of config.inputs) defaults[i.id] = i.default;
const initial = config.compute({ ...defaults });

function fmt(n, decimals) {
  if (typeof n !== 'number' || !isFinite(n)) return '—';
  const d = decimals ?? (Math.abs(n) < 10 && n % 1 !== 0 ? 1 : 0);
  return n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}

const isNumericOptions = (input) => input.options?.every((o) => typeof o.value === 'number');
const primary = config.outputs.find((o) => o.primary);
const secondary = config.outputs.filter((o) => !o.primary);

const span = (t) => (t === 'slider' || t === 'preset' ? 'sm:col-span-2' : 'sm:col-span-1');
const fieldBase =
  'w-full rounded-none border border-rule bg-white px-3 py-2.5 text-base text-ink shadow-none transition-colors hover:border-mute focus:border-blueprint';
---

<section
  data-calc={config.slug}
  class="mx-auto grid max-w-6xl gap-8 px-5 pt-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10"
>
  {/* ── 输入区 ───────────────────────────────── */}
  <div>
    <div class="flex items-center gap-3">
      <svg
        viewBox="0 0 24 24"
        class="h-9 w-9 shrink-0 stroke-blueprint"
        fill="none"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={ICONS[config.slug]} />
      </svg>
      <div>
        <p class="eyebrow">{config.keyword}</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{config.h1}</h1>
      </div>
    </div>
    <p class="mt-2 max-w-xl text-slate">{config.tagline}</p>

    <div class="mt-6 border border-rule bg-white">
      <div class="flex items-center justify-between border-b border-rulesoft px-4 py-3">
        <span class="eyebrow">Measurements</span>
        <div class="no-print flex" role="group" aria-label="Unit system">
          {
            [
              ['imperial', 'ft / in'],
              ['metric', 'm / cm'],
            ].map(([id, label]) => (
              <button
                type="button"
                data-units={id}
                aria-pressed={id === 'imperial' ? 'true' : 'false'}
                class="border border-rule px-3 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-slate first:border-r-0 aria-pressed:border-blueprint aria-pressed:bg-blueprint aria-pressed:text-white"
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="grid gap-x-5 gap-y-4 p-4 sm:grid-cols-2">
        {
          config.inputs.map((input) => (
            <div class={span(input.type)}>
              {input.type === 'toggle' ? (
                <label class="flex cursor-pointer items-start gap-3 py-1.5">
                  <input
                    type="checkbox"
                    id={`f-${input.id}`}
                    data-input={input.id}
                    data-type="toggle"
                    checked={input.default}
                    class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-blueprint)]"
                  />
                  <span>
                    <span class="text-sm font-medium">{input.label}</span>
                    {input.help && <span class="mt-0.5 block text-xs text-mute">{input.help}</span>}
                  </span>
                </label>
              ) : (
                <>
                  <label
                    for={`f-${input.id}`}
                    class="flex items-baseline justify-between gap-2 text-sm font-medium"
                  >
                    <span>{input.label}</span>
                    {input.type === 'slider' && (
                      <span class="tabnum text-xs text-slate">
                        <span data-slider-value={input.id}>{input.default}</span>
                        <span data-unit-label={input.unit}>{unitLabel(input.unit, 'imperial')}</span>
                      </span>
                    )}
                  </label>

                  <div class="mt-1.5 flex items-stretch">
                    {input.type === 'number' && (
                      <>
                        <input
                          type="number"
                          inputmode="decimal"
                          id={`f-${input.id}`}
                          data-input={input.id}
                          data-type="number"
                          data-kind={input.unit}
                          value={input.default}
                          min={input.min}
                          step={input.step}
                          class={fieldBase}
                        />
                        {unitLabel(input.unit, 'imperial') && (
                          <span
                            data-unit-label={input.unit}
                            class="flex min-w-[3.25rem] items-center justify-center border border-l-0 border-rule bg-paper px-2 font-mono text-xs text-mute"
                          >
                            {unitLabel(input.unit, 'imperial')}
                          </span>
                        )}
                      </>
                    )}

                    {(input.type === 'select' || input.type === 'preset') && (
                      <select
                        id={`f-${input.id}`}
                        data-input={input.id}
                        data-type={input.type}
                        data-numeric={String(!!isNumericOptions(input))}
                        class={fieldBase}
                      >
                        {input.options.map((o) => (
                          <option
                            value={o.value}
                            selected={o.value === input.default}
                            data-set={o.set ? JSON.stringify(o.set) : undefined}
                          >
                            {o.label}
                          </option>
                        ))}
                      </select>
                    )}

                    {input.type === 'slider' && (
                      <input
                        type="range"
                        id={`f-${input.id}`}
                        data-input={input.id}
                        data-type="slider"
                        data-kind={input.unit}
                        value={input.default}
                        min={input.min}
                        max={input.max}
                        step={input.step}
                        class="w-full"
                      />
                    )}
                  </div>

                  {input.help && input.type !== 'toggle' && (
                    <p class="mt-1 text-xs text-mute">{input.help}</p>
                  )}
                </>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* ── 结果票 ───────────────────────────────── */}
  <aside class="lg:sticky lg:top-6 lg:self-start">
    <div class="ticket border border-ink bg-white">
      <div class="flex items-center justify-between border-b border-rulesoft px-4 py-2.5">
        <span class="eyebrow">Materials ticket</span>
        <span class="h-[3px] w-6 bg-tape" aria-hidden="true"></span>
      </div>

      <div class="border-l-4 border-tape px-4 py-5">
        <p class="eyebrow" data-result-label>{primary.label}</p>
        <p class="tabnum mt-1 text-5xl font-bold leading-none tracking-tight">
          <span data-output={primary.id} data-kind={primary.unit} data-decimals={primary.decimals}
            >{fmt(initial[primary.id], primary.decimals)}</span
          >
        </p>
      </div>

      <div class="ticket-tear h-px w-full"></div>

      <dl class="divide-y divide-rulesoft px-4">
        {
          secondary.map((o) => (
            <div
              class="flex items-baseline justify-between gap-3 py-2.5 text-sm"
              data-result-row
              data-when={o.when}
              hidden={o.when ? !defaults[o.when] && !initial[o.when] : undefined}
            >
              <dt class="text-slate" data-result-label>
                {o.label}
              </dt>
              <dd class="tabnum shrink-0 font-medium">
                {o.type === 'range' ? (
                  <span data-output-range data-lo={o.lo} data-hi={o.hi}>
                    ${fmt(Math.round(initial[o.lo]))} – ${fmt(Math.round(initial[o.hi]))}
                  </span>
                ) : (
                  <>
                    <span data-output={o.id} data-kind={o.unit} data-decimals={o.decimals}>
                      {fmt(initial[o.id], o.decimals)}
                    </span>
                    {unitLabel(o.unit, 'imperial') && (
                      <span data-unit-label={o.unit} class="ml-1 text-xs font-normal text-mute">
                        {unitLabel(o.unit, 'imperial')}
                      </span>
                    )}
                  </>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="no-print flex gap-2 border-t border-rulesoft p-4">
        <button
          type="button"
          data-action="copy"
          class="flex-1 border border-ink bg-ink px-3 py-2 text-sm font-medium text-white hover:bg-blueprintdark"
          >Copy results</button
        >
        <button
          type="button"
          data-action="print"
          class="border border-rule px-3 py-2 text-sm font-medium text-slate hover:border-ink hover:text-ink"
          >Print</button
        >
      </div>
    </div>

    {
      config.outputs.some((o) => o.help) && (
        <ul class="mt-3 space-y-1.5 text-xs text-mute">
          {config.outputs
            .filter((o) => o.help)
            .map((o) => (
              <li>
                <span class="font-medium text-slate">{o.label}:</span> {o.help}
              </li>
            ))}
        </ul>
      )
    }
  </aside>
</section>

<script>
  import '../scripts/calc.js';
</script>
