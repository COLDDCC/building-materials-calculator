---
const { title, eyebrow } = Astro.props;
---
<section class="mx-auto max-w-2xl px-5 pt-10">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  <div class="mt-6 space-y-4 text-slate [&_h2]:mt-8 [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-ink [&_li]:mb-1 [&_ul]:list-disc [&_ul]:pl-5">
    <slot />
  </div>
</section>
