---
import Base from '../../layouts/Base.astro';
import { guides, guideBySlug } from '../../lib/guides.js';
import { bySlug, SITE } from '../../lib/registry.js';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { slug: g.slug } }));
}

const g = guideBySlug[Astro.props.slug];
const calc = bySlug[g.calculator];
const path = `/guides/${g.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.title,
    description: g.description,
    datePublished: g.updated,
    dateModified: g.updated,
    author: { '@type': 'Organization', name: SITE.name },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: new URL(path, SITE.domain).href,
  },
];
---

<Base
  title={`${g.title} – ${SITE.name}`}
  description={g.description}
  path={path}
  schema={schema}
  breadcrumbs={[
    { name: 'Calculators', path: '/' },
    { name: 'Guides', path: '/guides/' },
    { name: g.title, path },
  ]}
>
  <article class="mx-auto max-w-3xl px-5 pt-8">
    <p class="eyebrow">{g.keyword}</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{g.title}</h1>
    <p class="mt-3 text-lg text-slate">{g.description}</p>

    {
      calc && (
        <a
          href={`/${calc.slug}/`}
          class="mt-6 flex items-center justify-between gap-4 border-l-4 border-tape bg-white px-4 py-3 no-underline hover:border-blueprint"
        >
          <span>
            <span class="eyebrow block">Skip the maths</span>
            <span class="font-medium text-ink">Open the {calc.h1}</span>
          </span>
          <span class="font-mono text-lg text-blueprint" aria-hidden="true">→</span>
        </a>
      )
    }

    <div class="mt-8">
      {
        g.body.map((b) => {
          if (b.t === 'h2') return <h2 class="mt-10 text-xl font-bold tracking-tight sm:text-2xl">{b.v}</h2>;
          if (b.t === 'h3') return <h3 class="mt-8 text-base font-bold tracking-tight text-ink">{b.v}</h3>;
          if (b.t === 'p') return <p class="mt-4 text-slate">{b.v}</p>;
          if (b.t === 'html') return <p class="mt-4 text-slate" set:html={b.v} />;
          if (b.t === 'callout') return <p class="mt-6 border-l-4 border-tape bg-tapesoft px-4 py-3 text-ink">{b.v}</p>;
          if (b.t === 'ul')
            return <ul class="mt-4 list-disc space-y-2 pl-5 text-slate">{b.v.map((li) => <li>{li}</li>)}</ul>;
          if (b.t === 'ol')
            return <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate">{b.v.map((li) => <li>{li}</li>)}</ol>;
          if (b.t === 'table')
            return (
              <div class="mt-6 overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                  <thead>
                    <tr class="border-b-2 border-ink text-left">
                      {b.head.map((h) => (
                        <th class="py-2 pr-4 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-mute">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {b.rows.map((r) => (
                      <tr class="border-b border-rulesoft">
                        {r.map((c, i) => (
                          <td class={`py-2.5 pr-4 ${i === 0 ? 'font-medium' : 'text-slate'}`}>{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
                {b.note && <p class="mt-3 text-sm text-mute">{b.note}</p>}
              </div>
            );
          return null;
        })
      }
    </div>

    {
      calc && (
        <a
          href={`/${calc.slug}/`}
          class="mt-12 flex items-center justify-between gap-4 border border-ink bg-white px-4 py-4 no-underline hover:bg-paper"
        >
          <span>
            <span class="eyebrow block">Run the numbers</span>
            <span class="font-medium text-ink">{calc.h1}</span>
            <span class="mt-0.5 block text-sm text-mute">{calc.tagline}</span>
          </span>
          <span class="font-mono text-lg text-blueprint" aria-hidden="true">→</span>
        </a>
      )
    }
  </article>
</Base>
