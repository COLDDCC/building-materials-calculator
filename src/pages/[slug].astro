---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import { calculators, bySlug, SITE } from '../lib/registry.js';
import { guideSlugs } from '../lib/guides.js';
import { ICONS } from '../lib/icons.js';

export function getStaticPaths() {
  return calculators.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}

const config = bySlug[Astro.props.slug];
const copy = config.copy;
const path = `/${config.slug}/`;

// 只链已发布的支撑文章，避免站内 404
const guides = (copy?.guides || []).filter((g) => guideSlugs.has(g.slug));

const related = (copy?.related || [])
  .map((s) => bySlug[s])
  .filter(Boolean)
  .slice(0, 6);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: config.h1,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    url: new URL(path, SITE.domain).href,
    description: config.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

if (copy?.faq?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const H2 = 'text-xl font-bold tracking-tight text-ink sm:text-2xl';
const SECTION = 'mx-auto max-w-3xl px-5 pt-14';
---

<Base
  title={config.title}
  description={config.description}
  path={path}
  schema={schema}
  breadcrumbs={[
    { name: 'Calculators', path: '/' },
    { name: config.h1, path },
  ]}
>
  <!-- 3.1 首屏：计算器组件（前面不放任何介绍文字） -->
  <Calculator config={config} />

  <!-- 3.2 结果解读 -->
  <section class={SECTION}>
    <p class="eyebrow">Reading the result</p>
    <p class="mt-2 text-lg leading-relaxed text-slate">{copy.resultNote}</p>
  </section>

  <!-- 3.3 公式明示 -->
  <section class={SECTION}>
    <p class="eyebrow">The formula</p>
    <h2 class={`mt-1 ${H2}`}>How this calculator works</h2>
    <pre class="mt-4 overflow-x-auto border-l-4 border-tape bg-blueprintdark px-4 py-4 font-mono text-[0.8125rem] leading-relaxed text-white"><code>{copy.formula.lines.join('\n')}</code></pre>
    <div class="mt-5 space-y-4 text-slate">
      {copy.formula.body.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- 3.4 完整算例 -->
  <section class={SECTION}>
    <p class="eyebrow">Worked example</p>
    <h2 class={`mt-1 ${H2}`}>{copy.example.title}</h2>
    <ol class="mt-4 divide-y divide-rulesoft border-y border-rule">
      {
        copy.example.steps.map(([label, value]) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2.5">
            <span class="text-sm text-slate">{label}</span>
            <span class="tabnum text-sm font-medium">{value}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-slate">{copy.example.conclusion}</p>
  </section>

  <!-- 3.5 参考数据表 -->
  {
    copy.tables.map((t) => (
      <section class={SECTION}>
        <p class="eyebrow">Reference</p>
        <h2 class={`mt-1 ${H2}`}>{t.title}</h2>
        {t.intro && <p class="mt-2 text-slate">{t.intro}</p>}
        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-ink text-left">
                {t.head.map((h) => (
                  <th class="py-2 pr-4 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-mute">
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {t.rows.map((r) => (
                <tr class="border-b border-rulesoft align-top">
                  {r.map((cell, i) => (
                    <td class={`py-2.5 pr-4 ${i === 0 ? 'font-medium' : 'text-slate'}`}>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {t.note && <p class="mt-3 text-sm text-mute">{t.note}</p>}
      </section>
    ))
  }

  <!-- 3.6 FAQ -->
  <section class={SECTION}>
    <p class="eyebrow">Questions</p>
    <h2 class={`mt-1 ${H2}`}>Frequently asked</h2>
    <div class="mt-4 divide-y divide-rulesoft border-t border-rule">
      {
        copy.faq.map((f) => (
          <details class="group py-3">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 font-medium">
              <span>{f.q}</span>
              <span
                class="shrink-0 font-mono text-lg leading-none text-mute group-open:hidden"
                aria-hidden="true"
              >
                +
              </span>
              <span
                class="hidden shrink-0 font-mono text-lg leading-none text-mute group-open:block"
                aria-hidden="true"
              >
                −
              </span>
            </summary>
            <p class="mt-2 pr-8 text-slate">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 支撑文章 -->
  {
    guides.length > 0 && (
      <section class={SECTION}>
        <p class="eyebrow">Read next</p>
        <ul class="mt-3 space-y-2">
          {guides.map((g) => (
            <li>
              <a href={`/guides/${g.slug}/`} class="text-[0.9375rem]">
                {g.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 3.7 相关计算器 -->
  <section class={SECTION}>
    <p class="eyebrow">Related</p>
    <h2 class={`mt-1 ${H2}`}>Calculators for the same job</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        related.map((r) => (
          <a
            href={`/${r.slug}/`}
            class="group flex items-start gap-3 border border-rule bg-white p-4 no-underline transition-colors hover:border-ink"
          >
            <svg
              viewBox="0 0 24 24"
              class="mt-0.5 h-5 w-5 shrink-0 stroke-blueprint"
              fill="none"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d={ICONS[r.slug]} />
            </svg>
            <span>
              <span class="block font-medium text-ink group-hover:text-blueprint">{r.h1}</span>
              <span class="mt-0.5 block text-sm text-mute">{r.tagline}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 3.8 免责声明（每个计算器页固定文案） -->
  <section class="mx-auto max-w-3xl px-5 pt-14">
    <p
      class="border-l-4 border-rule bg-white px-4 py-4 text-sm text-mute"
    >
      Results are estimates. Actual quantities vary with installation method, site conditions and
      material waste. Confirm quantities with your supplier or a licensed contractor before making a
      significant purchase.
    </p>
  </section>
</Base>
