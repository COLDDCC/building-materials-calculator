---
import Base from '../layouts/Base.astro';
import { grouped, calculators, SITE } from '../lib/registry.js';

const groups = grouped();
---

<Base
  title={`${SITE.name} – Building Material Calculators`}
  description="Free calculators for drywall, tile, wallpaper, concrete block, mulch and more. Enter your room or project size and get the quantity to order, with the formula shown."
  path="/"
  breadcrumbs={[{ name: 'Calculators', path: '/' }]}
>
  <section class="mx-auto max-w-6xl px-5 pt-10 pb-2">
    <p class="eyebrow">{calculators.length} calculators</p>
    <h1 class="mt-2 max-w-2xl text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
      The number you <span class="bg-tapesoft box-decoration-clone px-1">actually order</span>.
    </h1>
    <p class="mt-4 max-w-xl text-lg text-slate">
      Enter the size of the room, wall or bed. Get quantities, not square footage — with the formula
      written out so you can check it.
    </p>

    <div class="no-print mt-6 max-w-md">
      <label for="site-search" class="sr-only">Search calculators</label>
      <input
        type="search"
        id="site-search"
        placeholder="Search — drywall, mulch, tile…"
        autocomplete="off"
        class="w-full border border-rule bg-white px-3 py-2.5 text-base focus:border-blueprint"
      />
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="mx-auto max-w-6xl px-5 pt-12" data-group>
        <div class="flex items-baseline gap-3 border-b-2 border-ink pb-2">
          <h2 class="text-lg font-bold tracking-tight">{g.label}</h2>
          <p class="text-sm text-mute">{g.blurb}</p>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((c) => (
            <a
              href={`/${c.slug}/`}
              data-card
              data-name={`${c.h1} ${c.keyword}`.toLowerCase()}
              class="group border border-rule bg-white p-4 no-underline transition-colors hover:border-ink"
            >
              <span class="block font-medium text-ink group-hover:text-blueprint">{c.h1}</span>
              <span class="mt-1 block text-sm text-mute">{c.tagline}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <p class="mx-auto mt-14 max-w-6xl px-5 text-sm text-mute" data-empty hidden>
    No calculator matches that yet. More are being added every week.
  </p>
</Base>

<script>
  const search = document.getElementById('site-search');
  const cards = Array.from(document.querySelectorAll('[data-card]'));
  const groups = Array.from(document.querySelectorAll('[data-group]'));
  const empty = document.querySelector('[data-empty]');

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    cards.forEach((c) => {
      c.hidden = q ? !c.dataset.name.includes(q) : false;
    });
    groups.forEach((g) => {
      g.hidden = !Array.from(g.querySelectorAll('[data-card]')).some((c) => !c.hidden);
    });
    if (empty) empty.hidden = !q || groups.some((g) => !g.hidden);
  });
</script>
