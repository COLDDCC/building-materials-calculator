---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/registry.js';
---
<Base
  title={`Page not found – ${SITE.name}`}
  description="That page does not exist. The link may be old or mistyped."
  path="/404/"
  breadcrumbs={[{ name: 'Calculators', path: '/' }, { name: 'Not found', path: '/404/' }]}
>
  <section class="mx-auto max-w-3xl px-5 pt-20 pb-10">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">That page is off the plan.</h1>
    <p class="mt-4 text-lg text-slate">
      The address you followed doesn't match anything on this site. Try one of these instead.
    </p>
    <ul class="mt-6 space-y-2">
      <li><a href="/">Browse all {SITE.name} calculators</a></li>
      <li><a href="/guides/">Read the guides</a></li>
      <li><a href="/contact/">Report the broken link</a></li>
    </ul>
  </section>
</Base>
